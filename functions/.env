# Non-secret classroom endpoint config, loaded by firebase-functions (dotenv) at deploy.
# Tracked (not a secret) — same value every game uses.
#
# CLASSROOM_ROSTER_URL — the matcher reads the course roster (syncRoster/getRoster).
# CLASSROOM_CALLBACK_URL — the matcher is the GRADER for its guest game: scoreAndRecord
#   pools every team's cost, computes a cross-team z-score, and pushes the gradebook here
#   (receiveGameResult). The guest game's own auto-push is disabled (it can only see one
#   team), so the matcher owns grading end-to-end.
CLASSROOM_ROSTER_URL=https://getcourseroster-l7c4wlyhgq-uc.a.run.app
CLASSROOM_CALLBACK_URL=https://classroom.mygames.live/api/game-results
