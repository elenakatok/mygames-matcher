# Non-secret classroom endpoint config, loaded by firebase-functions (dotenv) at deploy.
# Tracked (not a secret) — same value every game uses.
#
# The matcher reads the course roster (syncRoster/getRoster) but never pushes grades — the
# Beer Game pushes participation grades directly — so it needs the ROSTER url only, NOT
# CLASSROOM_CALLBACK_URL (receivegameresult), which the other games set for their own
# finalize/push path.
CLASSROOM_ROSTER_URL=https://getcourseroster-l7c4wlyhgq-uc.a.run.app
