# dependencies + build output
**/node_modules/
functions/lib/
frontend/dist/
.firebase/

# secrets + local env (never commit)
**/.env
**/.env.*
!**/.env.example
# ...except functions/.env, which holds only NON-secret classroom endpoint URLs and is
# tracked like every other game's (secrets live in .secret.local / Secret Manager, not here).
!functions/.env
**/.secret.local

