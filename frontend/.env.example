# Matcher frontend web config. Copy to .env.development and .env.production and fill in the
# matcher project's PUBLIC Firebase web config (safe to expose; gated by Firestore rules).
# Both real env files are gitignored (matcher .gitignore: **/.env.*), so they are per-machine.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=matcher-mygames-live.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://matcher-mygames-live-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=matcher-mygames-live
VITE_FIREBASE_STORAGE_BUCKET=matcher-mygames-live.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ⚠ No VITE_PLAY_URL (removed in pass C, D12): the guest's play origin lives only in
# functions/src/tenants.ts. A VITE_PLAY_URL left in a local .env.* file is now unused.
