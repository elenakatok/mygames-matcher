rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═════════════════════════════════════════════════════════════════════════
    // ⚠ SAFETY-CRITICAL FILE. Deploy it with
    //     firebase deploy --only firestore:rules,firestore:indexes,database
    // Missing Firestore rules present as students seeing "Missing or insufficient
    // permissions"; missing RTDB rules present as presence `permission_denied` and a
    // Match button that never enables. Neither symptom names the rules.
    // ═════════════════════════════════════════════════════════════════════════

    match /game_instances/{instanceId}/participants/{participantId} {
      // A student can read their own record. Not anyone else's — the roster carries
      // real names and emails.
      allow read: if request.auth != null && request.auth.uid == participantId;

      // A student can update their own display name and any prep/KC answer field.
      //
      // ⚠ A BLOCKLIST, NOT AN ALLOWLIST, AND ON PURPOSE. The question editor invents
      // new field names at run time (prep_abc123), so an allowlist would require a
      // rules redeploy every time Elena adds a question — and the failure mode of
      // forgetting is a student whose answer silently will not save.
      //
      // Everything that decides a GRADE or an identity is blocked. Adding a new
      // protected field to the code means adding it to this list in the same commit.
      allow update: if request.auth != null
        && request.auth.uid == participantId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'group_id', 'raw_score', 'normalized_score',
                      'knowledge_check_score', 'knowledge_check_attempts',
                      'prep_status', 'prep_completed_at', 'debrief_initial_offer',
                      'finalized_at', 'attendance_confirmed_at', 'confirmed_ready_at',
                      'is_lead', 'is_bot', 'participant_id', 'game_instance_id',
                      'participant_late', 'value_or_cost']);
    }

    // Internal role-balancing counter. Server only.
    match /game_instances/{instanceId}/role_counts/{doc} {
      allow read, write: if false;
    }

    // Game config — PDF URLs, the clock, payoff settings. Server only: students get
    // only their own role's private URL, via the getInfoUrls callable.
    match /game_instances/{instanceId}/config/{doc} {
      allow read, write: if false;
    }

    // Attendance code — the current in-class code. Server only: the student never reads
    // it, they TYPE it and the verifyAttendanceCode callable checks it server-side.
    match /game_instances/{instanceId}/attendance_code/{doc} {
      allow read, write: if false;
    }

    // Groups. Written by Cloud Functions (the admin SDK bypasses rules); readable by any
    // authenticated participant so the group reveal, the member list, and the hand-off
    // redirect (which reads the group's `gameCode`) work.
    //
    // ⚠ THE MATCHER HAS NO PRIVATE PER-SEAT STATE. A group doc holds only membership,
    // names, emails, and the guest-game `gameCode` — all shared by design (the gameCode
    // is the shared Beer Game session code, not a per-seat secret). There is no round
    // loop and no hidden-draw collection here (unlike a stage game). If that ever changes,
    // private per-seat state must NOT live on the group doc.
    match /game_instances/{instanceId}/groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /game_instances/{instanceId}/groups/{groupId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
